[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "lustro"
version = "0.1.0"
description = "Compliant, open-source media collector: official APIs / robots-allowed only, live-verified, license-tracked."
readme = "README.md"
requires-python = ">=3.10"
license = { text = "MIT" }
authors = [{ name = "Wiktor Wojtarowicz" }]
keywords = ["scraping", "collector", "openverse", "creative-commons", "images", "compliant"]
dependencies = ["requests>=2.31", "Pillow>=10.0"]

[project.scripts]
lustro = "lustro.__main__:main"

[project.urls]
Homepage = "https://github.com/your-org/lustro"

[tool.setuptools.packages.find]
include = ["lustro*"]
